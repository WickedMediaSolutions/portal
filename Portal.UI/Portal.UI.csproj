<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Portal.Core\Portal.Core.csproj" />
    <ProjectReference Include="..\Portal.Networking\Portal.Networking.csproj" />
    <ProjectReference Include="..\Portal.Protocol\Portal.Protocol.csproj" />
    <ProjectReference Include="..\Portal.Services\Portal.Services.csproj" />
    <ProjectReference Include="..\Portal.State\Portal.State.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    Release identity for the distributed client.

    The executable/assembly name deliberately stays "Portal.UI" so the existing
    project layout, namespaces and solution references are untouched; only the
    *displayed* product identity carries the official client name.
  -->
  <PropertyGroup>
    <Product>Rites of Passage: The Portal</Product>
    <AssemblyTitle>Rites of Passage: The Portal</AssemblyTitle>
    <Company>Wicked Media Solutions</Company>
    <Copyright>Copyright © 2026 Wicked Media Solutions</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-beta</InformationalVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Release builds never ship a debuggable, developer-local client. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Linked image assets from repo root -->
  <ItemGroup>
    <Resource Include="..\RaceImages\*.jpg" Link="Assets\RaceImages\%(Filename)%(Extension)" />
    <Resource Include="..\charpanelimages\*.png" Link="Assets\charpanelimages\%(Filename)%(Extension)" />
    <Resource Include="..\monsterimages\*.png" Link="Assets\monsterimages\%(Filename)%(Extension)" />
    <Resource Include="..\compassimages\*.png" Link="Assets\compassimages\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
