<Window x:Class="Portal.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Portal.UI"
        mc:Ignorable="d"
        Title="Portal"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1024"
        Background="#151515"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush"      Color="#151515" />
        <SolidColorBrush x:Key="PanelBrush"            Color="#1C1C1C" />
        <SolidColorBrush x:Key="PanelAltBrush"         Color="#222222" />
        <SolidColorBrush x:Key="BorderBrush"           Color="#7A6B50" />
        <SolidColorBrush x:Key="BorderDimBrush"        Color="#4A4035" />
        <SolidColorBrush x:Key="HeaderTextBrush"       Color="#C4A96A" />
        <SolidColorBrush x:Key="BodyTextBrush"         Color="#B0B0B0" />
        <SolidColorBrush x:Key="DimTextBrush"          Color="#707070" />
        <SolidColorBrush x:Key="GreenAccentBrush"      Color="#5A8F4A" />
        <SolidColorBrush x:Key="GreenDimBrush"         Color="#3D6B32" />
        <SolidColorBrush x:Key="InputBackgroundBrush"  Color="#0D0D0D" />
        <SolidColorBrush x:Key="InputBorderBrush"      Color="#3A3530" />
        <SolidColorBrush x:Key="TabActiveBrush"        Color="#2A2A2A" />
        <SolidColorBrush x:Key="TabInactiveBrush"      Color="#1C1C1C" />
        <SolidColorBrush x:Key="StatusBarBrush"        Color="#111111" />
        <SolidColorBrush x:Key="StatusTextBrush"       Color="#888888" />
        <SolidColorBrush x:Key="HpBarBrush"            Color="#CC4444" />
        <SolidColorBrush x:Key="MpBarBrush"            Color="#4488CC" />
        <SolidColorBrush x:Key="SpBarBrush"            Color="#CCAA44" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style x:Key="PanelHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource GreenAccentBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="SelectionBrush" Value="#334422" />
        </Style>

        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TabInactiveBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDimBrush}" />
            <Setter Property="BorderThickness" Value="0,1,1,1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2,2,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A" />
                    <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{StaticResource GreenAccentBrush}" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <local:RatioBarWidthConverter x:Key="BarWidthConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================
             ROW 0 :: TOP AREA
             ======================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TOP BAR: Branding + Status -->
                <Border Grid.Row="0"
                        Padding="8,4"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderDimBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0"
                                 Style="{StaticResource StatusDotStyle}"
                                 VerticalAlignment="Center"
                                 Margin="4,0,8,0" />

                        <!-- Center: Branding -->
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock Text="&#x25C6;"
                                       Foreground="{StaticResource GreenAccentBrush}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="PORTAL"
                                       Style="{StaticResource SectionTitleStyle}"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#x25C6;"
                                       Foreground="{StaticResource GreenAccentBrush}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                        </StackPanel>

                        <!-- Right: Utility / Status -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Ellipse Style="{StaticResource StatusDotStyle}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Players: --"
                                           Style="{StaticResource BodyTextStyle}"
                                           FontSize="11"
                                           Foreground="{StaticResource DimTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                                       Background="{StaticResource BorderDimBrush}"
                                       Width="1" Margin="8,4" />
                            <TextBlock Text="00:00:00"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="11"
                                       Foreground="{StaticResource DimTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0" />
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                                       Background="{StaticResource BorderDimBrush}"
                                       Width="1" Margin="8,4" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Settings"
                                    Margin="2,0" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Themes"
                                    Margin="2,0" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Help"
                                    Margin="2,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TAB STRIP -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Background="{StaticResource PanelBrush}">
                    <Button Style="{StaticResource TabButtonStyle}"
                            Content="Main"
                            Background="{StaticResource TabActiveBrush}"
                            Foreground="{StaticResource BodyTextBrush}"
                            BorderThickness="0,0,1,1" />
                    <Button Style="{StaticResource TabButtonStyle}"
                            Content="Combat"
                            BorderThickness="0,0,1,1" />
                    <Button Style="{StaticResource TabButtonStyle}"
                            Content="Chat"
                            BorderThickness="0,0,1,1" />
                    <Button Style="{StaticResource TabButtonStyle}"
                            Content="Notes"
                            BorderThickness="0,0,1,1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================
             ROW 1 :: MAIN BODY (3 Columns)
             ======================================================== -->
        <Grid Grid.Row="1" Margin="3,3,3,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- COL 0: LEFT / MAIN -->
            <Grid Grid.Column="0" Margin="0,0,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Room / Title -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x25B8;"
                                   Foreground="{StaticResource GreenAccentBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="Room: Unknown"
                                   Style="{StaticResource PanelHeaderTextStyle}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Area: --"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="10" Foreground="{StaticResource DimTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Terminal Output -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}"
                        Background="{StaticResource InputBackgroundBrush}" Padding="0">
                    <ScrollViewer x:Name="TerminalScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="{StaticResource InputBackgroundBrush}">
                        <TextBlock x:Name="TerminalOutput"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="#909090" TextWrapping="Wrap"
                                   Margin="6,4" Text="" />
                    </ScrollViewer>
                </Border>

                <!-- Channel Tabs -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            Background="{StaticResource PanelBrush}" Margin="0,1,0,0">
                    <Button Style="{StaticResource TabButtonStyle}" Content="All"
                            Background="{StaticResource TabActiveBrush}"
                            Foreground="{StaticResource BodyTextBrush}"
                            BorderThickness="0,0,1,1" Padding="8,2" FontSize="10" />
                    <Button Style="{StaticResource TabButtonStyle}" Content="Say"
                            BorderThickness="0,0,1,1" Padding="8,2" FontSize="10" />
                    <Button Style="{StaticResource TabButtonStyle}" Content="Tell"
                            BorderThickness="0,0,1,1" Padding="8,2" FontSize="10" />
                    <Button Style="{StaticResource TabButtonStyle}" Content="Group"
                            BorderThickness="0,0,1,1" Padding="8,2" FontSize="10" />
                    <Button Style="{StaticResource TabButtonStyle}" Content="Guild"
                            BorderThickness="0,0,1,1" Padding="8,2" FontSize="10" />
                    <Button Style="{StaticResource TabButtonStyle}" Content="OOC"
                            BorderThickness="0,0,1,1" Padding="8,2" FontSize="10" />
                </StackPanel>

                <!-- Command Input -->
                <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}"
                        Padding="2" Margin="0,2,0,0"
                        Background="{StaticResource InputBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&gt;"
                                   Foreground="{StaticResource GreenAccentBrush}"
                                   FontFamily="Consolas" FontSize="14"
                                   FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="4,0,6,0" />
                        <TextBox Grid.Column="1" x:Name="CommandInput"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 FontSize="13" BorderThickness="0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- COL 1: CENTER -->
            <Grid Grid.Column="1" Margin="2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.7*" />
                    <RowDefinition Height="0.5*" />
                    <RowDefinition Height="2.8*" />
                </Grid.RowDefinitions>

                <!-- Party Panel -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x2605; Party"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <Border Grid.Row="1" Background="{StaticResource InputBackgroundBrush}" CornerRadius="2" Padding="4" MinHeight="60">
                            <TextBlock Text="No party members."
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="10" Foreground="{StaticResource DimTextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Status Effects Panel -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x2726; Status Effects"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <Border Grid.Row="1" Background="{StaticResource InputBackgroundBrush}" CornerRadius="2" Padding="4" MinHeight="40">
                            <TextBlock Text="None active."
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="10" Foreground="{StaticResource DimTextBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Equipment Panel -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x2694; Equipment"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <Grid Grid.Row="1" Margin="2"
                              Background="{StaticResource InputBackgroundBrush}">
                            <!-- Base naked layer -->
                            <Image Source="/Assets/charpanelimages/eq-naked.png"
                                   Stretch="Uniform" />

                            <!-- Equipment overlays - hidden by default -->
                            <Image Source="/Assets/charpanelimages/eq-head.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-neck.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-earring-left.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-earring-right.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-torso.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-arms.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-wrists.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-finger-left.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-finger-right.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-waist.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-legs.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-feet.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-hands.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-left-hand-item.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                            <Image Source="/Assets/charpanelimages/eq-right-hand-item.png"
                                   Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Inventory / Keys / Coins -->
                <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x25C8; Inventory | Keys | Coins"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource InputBackgroundBrush}" Padding="4" Margin="1">
                                <StackPanel>
                                    <TextBlock Text="Inventory"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="9" Foreground="{StaticResource DimTextBrush}" />
                                    <TextBlock Text="0 items"
                                               Style="{StaticResource BodyTextStyle}" FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource InputBackgroundBrush}" Padding="4" Margin="1">
                                <StackPanel>
                                    <TextBlock Text="Keys"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="9" Foreground="{StaticResource DimTextBrush}" />
                                    <TextBlock Text="0 keys"
                                               Style="{StaticResource BodyTextStyle}" FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource InputBackgroundBrush}" Padding="4" Margin="1">
                                <StackPanel>
                                    <TextBlock Text="Coins"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="9" Foreground="{StaticResource DimTextBrush}" />
                                    <TextBlock Text="0 gp"
                                               Style="{StaticResource BodyTextStyle}" FontSize="10"
                                               Foreground="{StaticResource HeaderTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Navigation -->
                <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x25B2; Navigation"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <Grid Grid.Row="1"
                              Background="{StaticResource InputBackgroundBrush}">
                            <Image Source="/Assets/compassimages/compasstrans.png"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="8" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- COL 2: RIGHT -->
            <Grid Grid.Column="2" Margin="2,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="2.7*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="0.8*" />
                </Grid.RowDefinitions>

                <!-- Character Panel -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x2593; Character"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <Grid Grid.Row="1" Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Race Portrait -->
                            <Border Grid.Column="0"
                                    Width="90" Height="110"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDimBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Top">
                                <Image Source="/Assets/RaceImages/human.jpg"
                                        Stretch="UniformToFill"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>
<!-- Character Info -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Name -->
                                <TextBlock Grid.Row="0"
                                            Style="{StaticResource BodyTextStyle}" FontSize="12"
                                            FontWeight="SemiBold" Margin="0,0,0,2">
                                    <Run Text="Name: "/>
                                    <Run Text="{Binding Character.Name, FallbackValue=--}"/>
                                </TextBlock>
                                <!-- Race / Class -->
                                <Grid Grid.Row="1" Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                                Style="{StaticResource BodyTextStyle}" FontSize="10"
                                                Foreground="{StaticResource DimTextBrush}">
                                        <Run Text="Race: "/>
                                        <Run Text="{Binding Character.RaceName, FallbackValue=--}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                                Style="{StaticResource BodyTextStyle}" FontSize="10"
                                                Foreground="{StaticResource DimTextBrush}">
                                        <Run Text="Class: "/>
                                        <Run Text="{Binding Character.ProfessionName, FallbackValue=--}"/>
                                    </TextBlock>
                                </Grid>
                                <!-- Level -->
                                <TextBlock Grid.Row="2"
                                            Style="{StaticResource BodyTextStyle}" FontSize="10"
                                            Foreground="{StaticResource DimTextBrush}" Margin="0,2,0,0">
                                    <Run Text="Level: "/>
                                    <Run Text="{Binding Character.Level, FallbackValue=--}"/>
                                </TextBlock>
                                <!-- Separator -->
                                <Border Grid.Row="3" Height="1"
                                        Background="{StaticResource BorderDimBrush}"
                                        Margin="0,5,0,3" />
                                <!-- HP Bar -->
                                <Grid Grid.Row="4" Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HP:"
                                                Style="{StaticResource BodyTextStyle}" FontSize="10"
                                                Foreground="{StaticResource HpBarBrush}" Width="28"
                                                VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="10"
                                            Background="#2A1A1A" Margin="2,1,0,1">
                                        <Border Background="{StaticResource HpBarBrush}"
                                                HorizontalAlignment="Left"
                                                Width="{Binding Character.HpRatio,
                                                    Converter={StaticResource BarWidthConverter},
                                                    ConverterParameter=90,
                                                    FallbackValue=70}" />
                                    </Border>
                                </Grid>
                                <!-- MA Bar (Mana — hidden for non-mana professions) -->
                                <Grid Grid.Row="5" Margin="0,1,0,0"
                                        Visibility="{Binding Character.HasMana,
                                            Converter={StaticResource BoolToVisConverter},
                                            FallbackValue=Visible}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MA:"
                                                Style="{StaticResource BodyTextStyle}" FontSize="10"
                                                Foreground="{StaticResource MpBarBrush}" Width="28"
                                                VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="10"
                                            Background="#1A1A2A" Margin="2,1,0,1">
                                        <Border Background="{StaticResource MpBarBrush}"
                                                HorizontalAlignment="Left"
                                                Width="{Binding Character.ManaRatio,
                                                    Converter={StaticResource BarWidthConverter},
                                                    ConverterParameter=90,
                                                    FallbackValue=50}" />
                                    </Border>
                                </Grid>
                                <!-- MV Bar (Movement Points) -->
                                <Grid Grid.Row="6" Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MV:"
                                                Style="{StaticResource BodyTextStyle}" FontSize="10"
                                                Foreground="{StaticResource SpBarBrush}" Width="28"
                                                VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="10"
                                            Background="#2A2A1A" Margin="2,1,0,1">
                                        <Border Background="{StaticResource SpBarBrush}"
                                                HorizontalAlignment="Left"
                                                Width="{Binding Character.StaminaRatio,
                                                    Converter={StaticResource BarWidthConverter},
                                                    ConverterParameter=90,
                                                    FallbackValue=60}" />
                                    </Border>
                                </Grid>
                                <!-- EXP -->
                                <TextBlock Grid.Row="7"
                                            Style="{StaticResource BodyTextStyle}" FontSize="10"
                                            Foreground="{StaticResource DimTextBrush}" Margin="0,3,0,0">
                                    <Run Text="EXP: "/>
                                    <Run Text="{Binding Character.XpDisplay, Mode=OneWay, FallbackValue=--}"/>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <!-- Current Target -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x260D; Current Target"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <Grid Grid.Row="1" Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Target Portrait placeholder -->
                            <Border Grid.Column="0"
                                    Width="90" Height="110"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDimBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Top">
                                <Image Source="/Assets/monsterimages/defaultmonster.png"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <!-- Target Info -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Name: --"
                                            Style="{StaticResource BodyTextStyle}" FontSize="12"
                                            FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock Grid.Row="1" Text="Level: --"
                                            Style="{StaticResource BodyTextStyle}" FontSize="10"
                                            Foreground="{StaticResource DimTextBrush}" Margin="0,0,0,2" />
                                <Border Grid.Row="2" Height="1"
                                        Background="{StaticResource BorderDimBrush}"
                                        Margin="0,4,0,4" />
                                <!-- Target HP Bar -->
                                <Grid Grid.Row="3" Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HP"
                                                Style="{StaticResource BodyTextStyle}" FontSize="10"
                                                Foreground="{StaticResource HpBarBrush}" Width="28"
                                                VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="12"
                                            Background="#2A1A1A" Margin="2,1,0,1">
                                        <Border Background="{StaticResource HpBarBrush}" Width="80"
                                                HorizontalAlignment="Left" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="4" Margin="0,3,0,0">
                                    <TextBlock Text="No target selected."
                                                Style="{StaticResource BodyTextStyle}" FontSize="10"
                                                Foreground="{StaticResource DimTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Mini Map -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x25EB; Mini Map"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <Border Grid.Row="1" Background="{StaticResource InputBackgroundBrush}" Padding="6" MinHeight="80">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Coordinates: --, --, --"
                                           Style="{StaticResource BodyTextStyle}" FontSize="9"
                                           Foreground="{StaticResource DimTextBrush}" />
                                <Border Grid.Row="1" Background="#0A0A0A"
                                        CornerRadius="1" Margin="0,2">
                                    <TextBlock Text="&#x25C6;" Foreground="{StaticResource GreenAccentBrush}"
                                               FontSize="14" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Opacity="0.5" />
                                </Border>
                                <TextBlock Grid.Row="2" Text="Region: --"
                                           Style="{StaticResource BodyTextStyle}" FontSize="9"
                                           Foreground="{StaticResource DimTextBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Combat Actions -->
                <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x26A1; Combat Actions"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <WrapPanel Grid.Row="1" Margin="0,2,0,0">
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Attack" Margin="1" Padding="8,3" FontSize="10" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Defend" Margin="1" Padding="8,3" FontSize="10" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Flee" Margin="1" Padding="8,3" FontSize="10" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Kick" Margin="1" Padding="8,3" FontSize="10" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Bash" Margin="1" Padding="8,3" FontSize="10" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Disarm" Margin="1" Padding="8,3" FontSize="10" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Rescue" Margin="1" Padding="8,3" FontSize="10" />
                            <Button Style="{StaticResource CompactButtonStyle}"
                                    Content="Backstab" Margin="1" Padding="8,3" FontSize="10" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Spells and Abilities -->
                <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#x2726; Spells and Abilities"
                                   Style="{StaticResource PanelHeaderTextStyle}" />
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{StaticResource InputBackgroundBrush}">
                            <ItemsControl Margin="2">
                                <TextBlock Text="(Spell book empty)"
                                           Style="{StaticResource BodyTextStyle}" FontSize="10"
                                           Foreground="{StaticResource DimTextBrush}" Margin="2" />
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================
             ROW 2 :: BOTTOM CONNECTION / STATUS BAR
             ======================================================== -->
        <Border Grid.Row="2"
                Background="{StaticResource StatusBarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Connection status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7"
                             Fill="{StaticResource GreenDimBrush}"
                             Margin="0,0,5,0" />
                    <TextBlock Text="Disconnected"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="11"
                               Foreground="{StaticResource StatusTextBrush}" />
                </StackPanel>

                <Separator Grid.Column="1"
                           Background="{StaticResource BorderDimBrush}"
                           Width="1" Margin="10,2" />

                <!-- Latency -->
                <TextBlock Grid.Column="2"
                           Text="Latency: -- ms"
                           Style="{StaticResource BodyTextStyle}"
                           FontSize="11"
                           Foreground="{StaticResource StatusTextBrush}"
                           VerticalAlignment="Center" />

                <!-- Session -->
                <TextBlock Grid.Column="3"
                           Text="Session: --"
                           Style="{StaticResource BodyTextStyle}"
                           FontSize="11"
                           Foreground="{StaticResource StatusTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0" />

                <!-- Version -->
                <TextBlock Grid.Column="4"
                           Text="Portal v0.1.0"
                           Style="{StaticResource BodyTextStyle}"
                           FontSize="11"
                           Foreground="{StaticResource StatusTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
